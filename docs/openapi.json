            "minLength": 1,
            "title": "Returned By",
            "type": "string"
          },
          "settle_type": {
            "maxLength": 10,
            "minLength": 1,
            "title": "Settle Type",
            "type": "string"
          }
        },
        "required": [
          "inspection_id",
          "settle_type",
          "quantity",
          "returned_by"
        ],
        "title": "PurchaseReturnIn",
        "type": "object"
      },
      "PurchaseReturnOut": {
        "description": "반품이 선 뒤 남은 것.\n\n**돌려주는 칸마다 까닭이 있다**(감사 ⑫ NC-137) —\n\n- `purchase_return_id` — 반품 문서에는 다른 손잡이가 없다. 같은 검사에 반품이 여럿\n  설 수 있어 `inspection_id` 로는 그 건을 가리키지 못한다\n- `ledger_entry_id` — 재고 로트를 돌려보냈으면 원장에서 빠졌다는 것을 부르는 쪽이\n  확인할 자리다. **불합격분이면 비어 있다** — 재고가 된 적이 없어 뺄 줄이 없다.\n  비어 있음이 그 구별을 말하므로 판정을 따로 싣지 않는다",
        "properties": {
          "ledger_entry_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ledger Entry Id"
          },
          "purchase_return_id": {
            "title": "Purchase Return Id",
            "type": "integer"
          }
        },
        "required": [
          "purchase_return_id",
          "ledger_entry_id"
        ],
        "title": "PurchaseReturnOut",
        "type": "object"
      },
      "RefusalDetail": {
        "description": "검사의 업무 규칙이 거절할 때 `detail[]` 에 실리는 줄.\n\n`type` 이 **기계가 읽는 자리**다. 알려진 이름은 `Refusal` 열거에서 끌어오고\n여기 다시 적지 않는다 — 두 벌이면 갈린다.",
        "properties": {
          "loc": {
            "items": {
              "type": "string"
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "description": "열린 문자열이다 — 알려진 값은 `x-known-values` 가 들고 늘 수 있다. 모르는 값을 받을 자리를 둔다.",
            "title": "Type",
            "type": "string",
            "x-known-values": [
              "unknown_item",
              "item_is_not_raw_material",
              "unknown_supplier",
              "partner_is_not_supplier",
