{
  "components": {
    "schemas": {
      "InspectionIn": {
        "additionalProperties": false,
        "description": "수입검사 한 건.",
        "properties": {
          "item_code": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Item Code",
            "type": "string"
          },
          "judged_by": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Judged By",
            "type": "string"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/MeasurementIn"
            },
            "title": "Measurements",
            "type": "array"
          },
          "nonconformity_code": {
            "anyOf": [
              {
                "maxLength": 30,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nonconformity Code"
          },
          "quantity": {
            "minimum": 0.0,
            "title": "Quantity",
            "type": "number"
          },
          "received_date": {
            "format": "date",
            "title": "Received Date",
            "type": "string"
          },
          "special_acceptance": {
            "default": false,
            "title": "Special Acceptance",
            "type": "boolean"
          },
          "supplier_code": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Supplier Code",
            "type": "string"
          },
          "supplier_lot_number": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Supplier Lot Number",
            "type": "string"
          }
        },
        "required": [
          "item_code",
          "supplier_code",
          "supplier_lot_number",
          "quantity",
          "judged_by",
          "received_date"
        ],
        "title": "InspectionIn",
        "type": "object"
      },
      "InspectionOut": {
        "description": "판정이 끝난 뒤 남은 것.\n\n**로트 번호를 돌려준다.** 창고 라벨에 찍히는 번호이고, 부르는 쪽이 그것을\n다시 물어보게 하면 한 사실을 두 번 읽게 된다.",
        "properties": {
          "inspection_id": {
            "title": "Inspection Id",
            "type": "integer"
          },
          "ledger_entry_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ledger Entry Id"
          },
          "lot_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lot Id"
          },
          "lot_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lot Number"
          },
          "nonconformity_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nonconformity Code"
          },
          "result": {
            "description": "열린 문자열이다 — 알려진 값은 `x-known-values` 가 들고 늘 수 있다. 모르는 값을 받을 자리를 둔다.",
            "title": "Result",
            "type": "string",
            "x-known-values": [
              "합격",
              "불합격",
              "특채"
            ]
          }
        },
        "required": [
          "inspection_id",
          "result",
          "nonconformity_code",
          "lot_id",
          "lot_number",
          "ledger_entry_id"
        ],
        "title": "InspectionOut",
        "type": "object"
      },
      "Invalid": {
        "description": "업무 이름 없이 pydantic 만 거절하는 경로의 422 본문.",
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationDetail"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Invalid",
        "type": "object"
      },
      "LotListRefusalDetail": {
        "description": "로트 목록이 커서를 거절할 때 `detail[]` 에 실리는 줄 — 이름은 `LotListRefusal` 이\n든다.",
        "properties": {
          "loc": {
            "items": {
              "type": "string"
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "description": "열린 문자열이다 — 알려진 값은 `x-known-values` 가 들고 늘 수 있다. 모르는 값을 받을 자리를 둔다.",
            "title": "Type",
            "type": "string",
            "x-known-values": [
              "cursor_is_not_readable",
              "cursor_is_for_another_list"
            ]
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "LotListRefusalDetail",
        "type": "object"
      },
      "LotListRefused": {
        "description": "`GET /lots` 의 422 본문 — `Refused` 와 **같은 모양이고 업무 이름의 열거만 다르다.**",
        "properties": {
          "detail": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/LotListRefusalDetail"
                },
                {
                  "$ref": "#/components/schemas/ValidationDetail"
                }
              ]
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "LotListRefused",
        "type": "object"
      },
      "LotMissing": {
        "description": "`GET /lots/{lot_id}` 의 404 본문 — **라우트 밖의 404 와 같은 모양이고 이름 공간만\n다르다.**",
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/LotRefusalDetail"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "LotMissing",
        "type": "object"
      },
      "LotOut": {
        "description": "로트 하나의 지금 — **잔량과 지금 만료일은 저장된 값이 아니라 센 값이다.**\n\n- `received_quantity` — 로트를 만든 입고 수량이다. 잔량이 아니다\n- `balance` — 원장 줄의 합. 반품 · 폐기가 빠진 지금의 양이다\n- `labelled_expiry_date` — 라벨에 찍혀 나간 만료일. 고쳐지지 않는다(원칙 ⑦)\n- `current_expiry_date` — 가장 최근에 합격한 재검사의 갱신 만료일, 없으면 라벨의\n  만료일(ADR 0017). 「오늘」은 현장 시간대가 가른다(ADR 0019)\n- `awaiting_retest` — 지금 만료일이 현장의 오늘보다 앞서고 잔량이 있는 원자재 로트다.\n  만료일 당일까지는 쓸 수 있다",
        "properties": {
          "awaiting_retest": {
            "title": "Awaiting Retest",
            "type": "boolean"
          },
          "balance": {
            "title": "Balance",
            "type": "number"
          },
          "current_expiry_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Expiry Date"
          },
          "item_code": {
            "title": "Item Code",
            "type": "string"
          },
          "labelled_expiry_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Labelled Expiry Date"
          },
          "lot_id": {
            "title": "Lot Id",
            "type": "integer"
          },
          "lot_number": {
            "title": "Lot Number",
            "type": "string"
          },
          "received_quantity": {
            "title": "Received Quantity",
            "type": "number"
          }
        },
        "required": [
          "lot_id",
          "lot_number",
          "item_code",
          "received_quantity",
          "balance",
          "labelled_expiry_date",
          "current_expiry_date",
          "awaiting_retest"
        ],
        "title": "LotOut",
        "type": "object"
      },
      "LotPageOut": {
        "description": "로트 목록의 한 쪽(ADR 0020).\n\n**대리키 순서다.** `next_cursor` 가 비어 있으면 마지막 쪽이다. 약속하는 것은 「넘기는 동안\n조건을 계속 채운 줄은 겹치지도 빠지지도 않는다」까지다 — 넘기는 사이 조건에 새로 든\n줄은 처음부터 다시 넘기면 보이고, 조건을 벗어난 줄은 오지 않는다.",
        "properties": {
          "lots": {
            "items": {
              "$ref": "#/components/schemas/LotOut"
            },
            "title": "Lots",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "lots",
          "next_cursor"
        ],
        "title": "LotPageOut",
        "type": "object"
      },
      "LotRefusalDetail": {
        "description": "로트 하나를 찾지 못할 때 `detail[]` 에 실리는 줄 — 이름은 `LotRefusal` 이 든다.",
        "properties": {
          "loc": {
