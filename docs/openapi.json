          },
          "renewed_expiry_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Renewed Expiry Date"
          },
          "result": {
            "description": "열린 문자열이다 — 알려진 값은 `x-known-values` 가 들고 늘 수 있다. 모르는 값을 받을 자리를 둔다.",
            "title": "Result",
            "type": "string",
            "x-known-values": [
