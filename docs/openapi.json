      "PurchaseReturnIn": {
        "additionalProperties": false,
        "description": "구매반품 한 건 — **검사를 가리킨다.** 로트 · 공급사 · 품목은 거기서 따라간다.",
        "properties": {
          "inspection_id": {
            "exclusiveMinimum": 0.0,
            "maximum": 2147483647.0,
            "title": "Inspection Id",
            "type": "integer"
