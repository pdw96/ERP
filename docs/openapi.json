{
  "components": {
    "schemas": {
      "InspectionIn": {
        "additionalProperties": false,
        "description": "수입검사 한 건.",
        "properties": {
          "item_code": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Item Code",
            "type": "string"
          },
          "judged_by": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Judged By",
            "type": "string"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/MeasurementIn"
            },
            "title": "Measurements",
            "type": "array"
          },
          "nonconformity_code": {
            "anyOf": [
              {
                "maxLength": 30,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nonconformity Code"
          },
          "quantity": {
            "minimum": 0.0,
            "title": "Quantity",
            "type": "number"
          },
          "received_date": {
            "format": "date",
            "title": "Received Date",
            "type": "string"
          },
          "special_acceptance": {
            "default": false,
            "title": "Special Acceptance",
            "type": "boolean"
          },
          "supplier_code": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Supplier Code",
            "type": "string"
          },
          "supplier_lot_number": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Supplier Lot Number",
            "type": "string"
          }
        },
        "required": [
          "item_code",
          "supplier_code",
          "supplier_lot_number",
          "quantity",
          "judged_by",
          "received_date"
        ],
        "title": "InspectionIn",
        "type": "object"
      },
      "InspectionOut": {
        "description": "판정이 끝난 뒤 남은 것.\n\n**로트 번호를 돌려준다.** 창고 라벨에 찍히는 번호이고, 부르는 쪽이 그것을\n다시 물어보게 하면 한 사실을 두 번 읽게 된다.",
        "properties": {
          "inspection_id": {
            "title": "Inspection Id",
            "type": "integer"
          },
          "ledger_entry_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ledger Entry Id"
          },
          "lot_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lot Id"
          },
          "lot_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lot Number"
          },
          "nonconformity_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nonconformity Code"
          },
          "result": {
            "enum": [
              "합격",
              "불합격",
              "특채"
            ],
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "inspection_id",
          "result",
          "nonconformity_code",
          "lot_id",
          "lot_number",
          "ledger_entry_id"
        ],
        "title": "InspectionOut",
        "type": "object"
      },
      "MeasurementIn": {
        "additionalProperties": false,
        "description": "검사원이 적은 실측값 하나.",
        "properties": {
          "item_code": {
            "maxLength": 30,
            "minLength": 1,
            "title": "Item Code",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "item_code",
          "value"
        ],
        "title": "MeasurementIn",
        "type": "object"
      },
      "Refusal": {
        "description": "업무 규칙이 거절할 때 `detail[].type` 으로 나가는 이름.\n\n**목록이 여기 한 벌이다.** 값을 고치는 것은 계약을 고치는 것이고, 메시지는\n고쳐도 되지만 이 이름은 고치면 깨진다.\n\n**상수 스물셋이 아니라 열거로 두는 이유**는 그 목록이 `/openapi.json` 에\n실려야 하기 때문이다 — 상수로 두면 소비자가 이름을 **문서화되지 않은 채\n하드코딩**하고, 이름이 늘어도 그것이 파괴적 변경으로 취급될 근거가 없다\n(감사 ⑫ NC-134). `result` 가 같은 이유로 `enum` 을 싣는다.\n\n**`StrEnum` 이라 `str` 과 같게 비교되고 JSON 으로 그대로 나간다** — 부르는\n쪽이 보는 값은 바뀌지 않는다.",
        "enum": [
          "unknown_item",
          "item_is_not_raw_material",
          "unknown_supplier",
          "partner_is_not_supplier",
          "received_date_is_in_the_future",
          "no_standard_for_material_group",
          "nothing_to_measure_for_material_group",
          "item_measured_twice",
          "item_is_not_in_the_standard",
          "measurement_is_missing",
          "no_reason_for_the_deviation",
          "reason_is_not_usable_at_this_gate",
          "reason_comes_with_a_computed_deviation",
          "special_acceptance_on_a_pass",
          "special_acceptance_is_not_open",
          "supplier_is_not_active",
          "reason_is_not_a_counted_one",
          "reason_is_derived_by_the_system",
          "reason_is_not_inspected_for_this_material",
          "reason_points_at_a_measured_item",
          "item_is_not_measured",
          "lot_number_would_not_fit",
          "material_is_already_expired"
        ],
        "title": "Refusal",
        "type": "string"
      },
      "RefusalDetail": {
        "description": "업무 규칙이 거절할 때 `detail[]` 에 실리는 줄.\n\n`type` 이 **기계가 읽는 자리**다. 이름 목록은 `Refusal` 한 벌이고 여기 다시\n적지 않는다 — 두 벌이면 갈린다.",
        "properties": {
          "loc": {
            "items": {
              "type": "string"
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/Refusal"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "RefusalDetail",
        "type": "object"
      },
      "Refused": {
        "description": "422 의 본문.\n\n**두 경로가 한 모양이다**(NC-75). 다른 것은 `type` 의 이름 공간뿐이고,\n그것을 위의 두 모델이 스펙에 적는다(감사 ⑫ NC-134).",
        "properties": {
          "detail": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RefusalDetail"
                },
                {
                  "$ref": "#/components/schemas/ValidationDetail"
                }
              ]
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Refused",
        "type": "object"
      },
      "Transport": {
        "description": "라우트 **밖에서** 나는 거절의 이름 — `detail[].type` 의 셋째 이름 공간.\n\n`Refusal` 은 업무 규칙이 거절할 때의 이름이고 이쪽은 **요청이 라우트에\n닿기 전이나 처리가 터진 뒤**의 이름이다. 둘을 한 열거로 합치지 않는 것은\n**층이 다르기 때문**이다 — 업무 이름은 관문 2 가 늘리고 이쪽은 늘지 않는다.\n\n**이 이름들이 여기 있는 이유는 NC-134 의 논거 그대로다.** 코드에만 있으면\n소비자가 문서화되지 않은 채 하드코딩하고, `http_error` 를 `path_error` 로\n고치는 커밋이 **어떤 검사도 물지 않고 어떤 스펙도 바꾸지 않은 채** 소비자의\n분기를 깬다 — NC-76 이 없앤 바로 그 모양이다(감사 ⑯ NC-160).",
        "enum": [
          "http_error",
          "internal_error"
        ],
        "title": "Transport",
        "type": "string"
      },
      "TransportDetail": {
        "description": "라우트 밖 거절의 `detail[]` 한 줄. `loc` 은 요청선 · 서버이고, 400 만 본문이다.",
        "properties": {
          "loc": {
            "items": {
              "type": "string"
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/Transport"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "TransportDetail",
        "type": "object"
      },
      "TransportRefused": {
        "description": "400 · 404 · 405 · 500 의 본문 — 422 와 **같은 모양이고 이름 공간만 다르다**.",
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/TransportDetail"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "TransportRefused",
        "type": "object"
      },
      "ValidationDetail": {
        "description": "pydantic 이 거절할 때 `detail[]` 에 실리는 줄.\n\n**같은 칸에 두 벌의 이름 공간이 산다.** `missing` · `extra_forbidden` 은\npydantic 이 정한 이름이고 위의 `Refusal` 은 우리가 정한 이름인데, 둘 다\n`type` 으로 나간다. 그래서 `type` 을 하나의 닫힌 열거로 적으면 **거짓**이\n된다 — 두 모양을 함께 적어 부르는 쪽이 어느 쪽인지 가릴 수 있게 한다.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationDetail",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "읽는 엔드포인트가 서기 전까지 이 계약은 **좁혀질 수 있고 판은 움직이지 않는다.** 그 조각이 서는 날부터 이동 규칙이 선다 — 깨지면 앞자리, 호환되게 넓어지면 뒷자리.\n\n거절의 본문은 어느 경로에서나 `detail[]` 한 모양이다. `detail[].type` 이 기계가 읽는 자리이고 이름 공간이 셋이다 — 업무 규칙의 `Refusal`, 라우트 밖의 `Transport`, 그리고 pydantic 이 정한 이름(`missing` · `extra_forbidden` 등). 앞의 둘은 이 스펙이 열거로 들고, **그 열거에 없는 값은 셋째 무리**다.",
    "summary": "수입검사 한 건을 받아 판정하고, 합격이면 로트를 만든다.",
    "title": "조기경보 ERP — 관문 1",
    "version": "0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/inspections": {
      "post": {
        "description": "검사 한 건을 받는다.\n\n**받을 수 없는 것은 422 로 이름을 말하고 돌려보낸다.** 제약이 터지고 나서\n나오는 말은 제약 이름이라 검사원에게 아무것도 알려 주지 않는다 — 「왜 막혔는지\n모르는 실패」는 고칠 수 없는 실패다. **어떤 갈래를 무엇이 막는지는 한 자리에만\n적는다** — `app/services/incoming.py` 의 `RefusedInspection` 이 든다.",
        "operationId": "post_inspection_inspections_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InspectionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectionOut"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Request-Id": {
                "description": "이 요청을 가리키는 값. 보내면 그대로 돌아오고, 없거나 모양이 맞지 않으면 우리가 짓는다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportRefused"
                }
              }
            },
            "description": "Bad Request",
            "headers": {
              "X-Request-Id": {
                "description": "이 요청을 가리키는 값. 보내면 그대로 돌아오고, 없거나 모양이 맞지 않으면 우리가 짓는다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportRefused"
                }
              }
            },
            "description": "Not Found",
            "headers": {
              "X-Request-Id": {
                "description": "이 요청을 가리키는 값. 보내면 그대로 돌아오고, 없거나 모양이 맞지 않으면 우리가 짓는다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportRefused"
                }
              }
            },
            "description": "Method Not Allowed",
            "headers": {
              "Allow": {
                "description": "이 경로가 받는 메서드.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "이 요청을 가리키는 값. 보내면 그대로 돌아오고, 없거나 모양이 맞지 않으면 우리가 짓는다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "Unprocessable Entity",
            "headers": {
              "X-Request-Id": {
                "description": "이 요청을 가리키는 값. 보내면 그대로 돌아오고, 없거나 모양이 맞지 않으면 우리가 짓는다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportRefused"
                }
              }
            },
            "description": "Internal Server Error",
            "headers": {
              "X-Request-Id": {
                "description": "이 요청을 가리키는 값. 보내면 그대로 돌아오고, 없거나 모양이 맞지 않으면 우리가 짓는다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Post Inspection"
      }
    }
  }
}
